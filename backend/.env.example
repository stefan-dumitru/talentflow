# Copy to .env for local development. .env is gitignored; never commit real credentials.
# Matches docker-compose.yml (local-only container on host port 5433).
DATABASE_URL=postgresql+psycopg://talentflow:talentflow@127.0.0.1:5433/talentflow
ENVIRONMENT=local
LOG_LEVEL=INFO

# Sign-in with Microsoft Entra External ID. Not secrets: they identify the tenant and the API
# app registration. Filled in when the tenant exists (Phase 1, Step 5). Until then every
# authenticated endpoint answers 503 "Authentication is not configured".
# AUTH_ISSUER=https://<tenant-id>.ciamlogin.com/<tenant-id>/v2.0
# AUTH_AUDIENCE=<application (client) id of the API app registration>
# AUTH_JWKS_URL=https://<tenant-subdomain>.ciamlogin.com/<tenant-id>/discovery/v2.0/keys
